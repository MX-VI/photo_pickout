# Git忽略文件

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints

# 模型和数据（大文件）
*.pth
*.pt
*.h5
*.pkl
*.ckpt

# 训练日志
logs/
runs/
wandb/

# 数据（用户自己的照片）
data/good/*
data/bad/*
data/test/*
!data/good/.gitkeep
!data/bad/.gitkeep
!data/test/.gitkeep

# 输出（生成的报告）
outputs/plots/*
outputs/reports/*
!outputs/plots/.gitkeep
!outputs/reports/.gitkeep

# 系统文件
.DS_Store
Thumbs.db
